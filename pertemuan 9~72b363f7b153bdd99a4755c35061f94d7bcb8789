import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.ArrayList;

public class AplikasiPenjualan extends JFrame {

    // ================= DATA =================
    private final ArrayList<String> barangList = new ArrayList<>();
    private final ArrayList<String> customerList = new ArrayList<>();
    private final ArrayList<String> supplierList = new ArrayList<>();

    // ================= MODEL TABLE =================
    private DefaultTableModel modelBarang;
    private DefaultTableModel modelCustomer;
    private DefaultTableModel modelSupplier;
    private DefaultTableModel modelTransaksi;

    // ================= COMPONENT TRANSAKSI =================
    private JComboBox<String> cbBarang;
    private JComboBox<String> cbCustomer;

    public AplikasiPenjualan() {

        setTitle("Aplikasi Penjualan Lengkap");
        setSize(900, 550);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        JTabbedPane tab = new JTabbedPane();

        // =====================================================
        // PANEL BARANG
        // =====================================================
        JPanel panelBarang = new JPanel(new BorderLayout(10, 10));

        JTextField txtBarang = new JTextField();
        JButton btnTambahBarang = new JButton("Tambah Barang");

        JPanel topBarang = new JPanel(new BorderLayout(5, 5));
        topBarang.add(txtBarang, BorderLayout.CENTER);
        topBarang.add(btnTambahBarang, BorderLayout.EAST);

        modelBarang = new DefaultTableModel(
                new String[]{"Nama Barang"}, 0
        );

        JTable tableBarang = new JTable(modelBarang);

        btnTambahBarang.addActionListener(e -> {

            String barang = txtBarang.getText().trim();

            if (barang.isEmpty()) {
                JOptionPane.showMessageDialog(this,
                        "Nama barang tidak boleh kosong!");
                return;
            }

            barangList.add(barang);
            modelBarang.addRow(new Object[]{barang});

            cbBarang.addItem(barang);

            txtBarang.setText("");
        });

        panelBarang.add(topBarang, BorderLayout.NORTH);
        panelBarang.add(new JScrollPane(tableBarang), BorderLayout.CENTER);

        // =====================================================
        // PANEL CUSTOMER
        // =====================================================
        JPanel panelCustomer = new JPanel(new BorderLayout(10, 10));

        JTextField txtCustomer = new JTextField();
        JButton btnTambahCustomer = new JButton("Tambah Customer");

        JPanel topCustomer = new JPanel(new BorderLayout(5, 5));
        topCustomer.add(txtCustomer, BorderLayout.CENTER);
        topCustomer.add(btnTambahCustomer, BorderLayout.EAST);

        modelCustomer = new DefaultTableModel(
                new String[]{"Nama Customer"}, 0
        );

        JTable tableCustomer = new JTable(modelCustomer);

        btnTambahCustomer.addActionListener(e -> {

            String customer = txtCustomer.getText().trim();

            if (customer.isEmpty()) {
                JOptionPane.showMessageDialog(this,
                        "Nama customer tidak boleh kosong!");
                return;
            }

            customerList.add(customer);
            modelCustomer.addRow(new Object[]{customer});

            cbCustomer.addItem(customer);

            txtCustomer.setText("");
        });

        panelCustomer.add(topCustomer, BorderLayout.NORTH);
        panelCustomer.add(new JScrollPane(tableCustomer), BorderLayout.CENTER);

        // =====================================================
        // PANEL SUPPLIER
        // =====================================================
        JPanel panelSupplier = new JPanel(new BorderLayout(10, 10));

        JTextField txtSupplier = new JTextField();
        JButton btnTambahSupplier = new JButton("Tambah Supplier");

        JPanel topSupplier = new JPanel(new BorderLayout(5, 5));
        topSupplier.add(txtSupplier, BorderLayout.CENTER);
        topSupplier.add(btnTambahSupplier, BorderLayout.EAST);

        modelSupplier = new DefaultTableModel(
                new String[]{"Nama Supplier"}, 0
        );

        JTable tableSupplier = new JTable(modelSupplier);

        btnTambahSupplier.addActionListener(e -> {

            String supplier = txtSupplier.getText().trim();

            if (supplier.isEmpty()) {
                JOptionPane.showMessageDialog(this,
                        "Nama supplier tidak boleh kosong!");
                return;
            }

            supplierList.add(supplier);
            modelSupplier.addRow(new Object[]{supplier});

            txtSupplier.setText("");
        });

        panelSupplier.add(topSupplier, BorderLayout.NORTH);
        panelSupplier.add(new JScrollPane(tableSupplier), BorderLayout.CENTER);

        // =====================================================
        // PANEL TRANSAKSI
        // =====================================================
        JPanel formTransaksi = new JPanel(new GridLayout(4, 2, 10, 10));

        cbBarang = new JComboBox<>();
        cbCustomer = new JComboBox<>();

        JTextField txtJumlah = new JTextField();

        JButton btnProses = new JButton("Proses Transaksi");

        formTransaksi.add(new JLabel("Barang"));
        formTransaksi.add(cbBarang);

        formTransaksi.add(new JLabel("Customer"));
        formTransaksi.add(cbCustomer);

        formTransaksi.add(new JLabel("Jumlah"));
        formTransaksi.add(txtJumlah);

        formTransaksi.add(new JLabel(""));
        formTransaksi.add(btnProses);

        modelTransaksi = new DefaultTableModel(
                new String[]{"Customer", "Barang", "Jumlah"}, 0
        );

        JTable tableTransaksi = new JTable(modelTransaksi);

        btnProses.addActionListener(e -> {

            String barang = (String) cbBarang.getSelectedItem();
            String customer = (String) cbCustomer.getSelectedItem();
            String jumlah = txtJumlah.getText().trim();

            if (barang == null) {
                JOptionPane.showMessageDialog(this,
                        "Barang belum tersedia!");
                return;
            }

            if (customer == null) {
                JOptionPane.showMessageDialog(this,
                        "Customer belum tersedia!");
                return;
            }

            if (jumlah.isEmpty()) {
                JOptionPane.showMessageDialog(this,
                        "Jumlah tidak boleh kosong!");
                return;
            }

            modelTransaksi.addRow(new Object[]{
                    customer,
                    barang,
                    jumlah
            });

            JOptionPane.showMessageDialog(this,
                    "Transaksi berhasil diproses!");

            txtJumlah.setText("");
        });

        JPanel panelTransaksi = new JPanel(new BorderLayout(10, 10));
        panelTransaksi.add(formTransaksi, BorderLayout.NORTH);
        panelTransaksi.add(new JScrollPane(tableTransaksi), BorderLayout.CENTER);

        // =====================================================
        // PANEL LAPORAN
        // =====================================================
        JPanel panelLaporan = new JPanel(new BorderLayout(10, 10));

        JTextArea txtLaporan = new JTextArea();
        txtLaporan.setEditable(false);

        JButton btnCetak = new JButton("Tampilkan Laporan");

        btnCetak.addActionListener(e -> {

            txtLaporan.setText("");

            if (modelTransaksi.getRowCount() == 0) {
                txtLaporan.setText("Belum ada transaksi.");
                return;
            }

            txtLaporan.append("===== LAPORAN TRANSAKSI =====\n\n");

            for (int i = 0; i < modelTransaksi.getRowCount(); i++) {

                txtLaporan.append(
                        "Customer : " + modelTransaksi.getValueAt(i, 0)
                                + "\nBarang   : " + modelTransaksi.getValueAt(i, 1)
                                + "\nJumlah   : " + modelTransaksi.getValueAt(i, 2)
                                + "\n-----------------------------\n"
                );
            }
        });

        panelLaporan.add(btnCetak, BorderLayout.NORTH);
        panelLaporan.add(new JScrollPane(txtLaporan), BorderLayout.CENTER);

        // =====================================================
        // TAB
        // =====================================================
        tab.addTab("Barang", panelBarang);
        tab.addTab("Customer", panelCustomer);
        tab.addTab("Supplier", panelSupplier);
        tab.addTab("Transaksi", panelTransaksi);
        tab.addTab("Laporan", panelLaporan);

        add(tab);
    }

    // =====================================================
    // MAIN
    // =====================================================
    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            new AplikasiPenjualan().setVisible(true);
        });
    }
}